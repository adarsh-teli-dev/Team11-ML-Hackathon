# ========================================
# PathSnap Team 11 — .gitignore
# ========================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# ---------- Virtual environments ----------
venv/
.venv/
env/
ENV/

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_metadata/

# ---------- Data (too large for GitHub) ----------
data/train/
data/student_test/
data/evaluator_test/
*.csv.gz

# ---------- Secrets ----------
.env
*.pem
*.key

# ---------- OS ----------
desktop.ini
ehthumbs.db

# ---------- Logs ----------
*.log
logs/

# ---------- Model artifacts (track with Git LFS or keep small) ----------
# Uncomment if models are too large:
# artifacts/*.pkl
# artifacts/*.joblib
# artifacts/*.h5
